# ignorar configurações locais do vs code
.vscode/

# ignorar dependências (muito pesadas para o github)
node_modules/

# ignorar arquivos de variáveis de ambiente (segurança!)
.env
.env.local

# ignorar arquivos do sistema operacional
.DS_Store
Thumbs.db

# ignorar cache
__pycache__/

# ignorar build\main
build/
*.py[cod]

# arquivos de especificação do PyInstaller
main.spec

# arquivos de especificação do BDD
.venv/
